{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "types": ["node"],
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["apps/**/*.ts", "packages/**/*.ts"]
}